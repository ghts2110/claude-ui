#!/bin/sh
# Roda dentro do pane principal: abre o sidebar à esquerda e vira a primeira
# conversa.

sidebar=$(tmux split-window -hbd -l 24 -P -F '#{pane_id}' -- \
	"$CLAUDE_UI_NODE" "$CLAUDE_UI_ROOT/sidebar/index.js")
tmux set -q @sidebar "$sidebar"

# Cabeçalho fixo acima da conversa (ver sidebar/cabecalho.js): 3 linhas, a
# altura do logo do Claude Code. Começa guardado numa janela própria e só
# aparece quando o logo original rola para fora.
cabecalho=$(tmux new-window -d -P -F '#{pane_id}' -- \
	"$CLAUDE_UI_NODE" "$CLAUDE_UI_ROOT/sidebar/cabecalho.js")
tmux set -q @cabecalho "$cabecalho"
tmux set -q @largura 24

# Largura escolhida (teclas < > no sidebar ou arrastando a borda) fica em
# @largura e é reaplicada ao redimensionar a janela, até metade dela (mesma
# conta de sidebar/conversas.js); o cabeçalho volta a ter 3 linhas. Escondido (zoom), não mexe: resize-pane
# tiraria o zoom.
metade='#{e|/:#{window_width},2}'
teto="#{?#{e|<:$metade,20},20,$metade}"
largura="#{?#{e|<:#{@largura},$teto},#{@largura},$teto}"
aplicar="if -F -t $sidebar '#{window_zoomed_flag}' '' \"run-shell -t $sidebar -C 'resize-pane -t $sidebar -x $largura' ; resize-pane -t $cabecalho -y 3\""
guardar="if -F -t $sidebar '#{window_zoomed_flag}' '' \"set -t $sidebar -F @largura '#{pane_width}'\""
tmux set-hook -w window-resized "$aplicar"
tmux run-shell -t "$sidebar" -C "$aplicar"
# Soltar o botão fora da borda (arrasto rápido até a beirada) chega como
# MouseDragEnd1Pane; o evento segue para o pane.
tmux bind -n MouseDragEnd1Border "$guardar ; $aplicar"
tmux bind -n MouseDragEnd1Pane "$guardar ; $aplicar ; send -M"

# Ctrl-T abre uma conversa nova e Ctrl-W fecha a da tela, de qualquer pane.
acao="$CLAUDE_UI_NODE $CLAUDE_UI_ROOT/sidebar/acao.js"
tmux bind -n C-t run-shell -b "$acao nova $sidebar"
tmux bind -n C-w confirm-before -b -c s -p "fechar a conversa da tela? (s/n)" \
	"run-shell -b '$acao fechar $sidebar'"
# Option-↑/↓ trazem a conversa de cima ou de baixo na lista, de qualquer pane.
# O Terminal.app não repassa o Cmd, então o Cmd+Option da ideia original
# fica só no Option. Sem -b: segurando a tecla, uma troca espera a anterior.
tmux bind -n M-Up run-shell "$acao subir $sidebar"
tmux bind -n M-Down run-shell "$acao descer $sidebar"

exec "$CLAUDE_UI_ROOT/bin/conversa" "$@"
